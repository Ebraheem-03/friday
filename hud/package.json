{
  "name": "friday-hud",
  "version": "0.1.0",
  "description": "FRIDAY Iron-Man style telemetry HUD — Electron + React + Three.js",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -p tsconfig.node.json --noEmit && npm run build:electron && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build:electron && electron ."
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "39.8.10",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}

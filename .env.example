# --- required ---
GEMINI_API_KEY=

# --- gemini model (default: gemini-2.5-flash) ---
GEMINI_MODEL=gemini-2.5-flash

# --- voice ---
SAMPLE_RATE=24000
TTS_VOICE=af_heart

# TTS engine: "gemini" (near-human cloud, ~3-5s/reply, default) or
# "kokoro" (local, instant, robotic). Gemini reuses GEMINI_API_KEY.
TTS_ENGINE=gemini
# Gemini prebuilt voice (when TTS_ENGINE=gemini): Kore, Puck, Charon, Aoede, ...
TTS_GEMINI_VOICE=Kore
TTS_GEMINI_MODEL=gemini-2.5-flash-preview-tts

# --- wake word (always-on activation) ---
# FRIDAY only responds to utterances containing the wake word (matched on the
# Whisper transcript). Set WAKE_WORD_ENABLED=0 to respond to every utterance.
WAKE_WORD=friday
WAKE_WORD_ENABLED=1

# --- optional design MCPs (HUD phase) ---
TWENTY_FIRST_API_KEY=
GOOGLE_CLOUD_PROJECT=

# --- runtime ---
TELEMETRY_WS_PORT=8765
LOG_LEVEL=INFO

# --- browser-use privacy / egress controls ---
# Disable browser-use PostHog telemetry (phones home on every agent run).
# Must be set before the first `import browser_use`; web/agent.py sets this
# at module load time via os.environ.setdefault so it is always applied.
# Ref: https://docs.browser-use.com/development/telemetry
ANONYMIZED_TELEMETRY=false
# Disable browser-use PyPI version-check HTTP call (fires on every agent.run()).
# browser_use.config.CONFIG.BROWSER_USE_VERSION_CHECK reads this env var.
# web/agent.py sets this at module load time alongside ANONYMIZED_TELEMETRY.
BROWSER_USE_VERSION_CHECK=false
